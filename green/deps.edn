{:paths ["src/clj" "src/resources"]
 :deps {org.clojure/clojure       {:mvn/version "1.12.5"}
        io.github.getcolors/green {:git/url "https://github.com/getcolors/green.git"
                                   :git/sha "ceb4159a19ec281d60f10d11295c05c5de5f1c42"}
        ;; 04f9623 is the first ONCE whose `compute` — the Compute Provider
        ;; Standard's operations this package delegates to, added in 417d5f7 —
        ;; reads a missing stage directory as an unreadable state rather than
        ;; letting the shell's IOException crash a fresh-clone create;
        ;; bc06f2f, below it, is where ONCE moved the machine keypair into
        ;; the operator's ~/.ssh. The pin cannot go below 04f9623.
        io.github.getcolors/once  {:git/url "https://github.com/getcolors/once.git"
                                   :git/sha "04f9623159358882f6407618f804f70ce7067e54"
                                   :deps/root "green"}}
 :aliases {:dev {:extra-paths ["test/clj" "test/resources"]}
           :test {:extra-paths ["test/clj" "test/resources"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}}}
