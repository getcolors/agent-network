{:paths ["test/clj" "test/resources"]
 :deps {io.github.getcolors/agent-network {:local/root "."}}
 :tasks
 {test {:requires ([clojure.test :as t]
                   [io.github.getcolors.agent-network.validate-test]
                   [io.github.getcolors.agent-network.ssh-test]
                   [io.github.getcolors.agent-network.ssh-config-test]
                   [io.github.getcolors.agent-network.tools-test]
                   [io.github.getcolors.agent-network.workflow-test])
        :task (let [{:keys [fail error]}
                    (t/run-tests 'io.github.getcolors.agent-network.validate-test
                                 'io.github.getcolors.agent-network.ssh-test
                                 'io.github.getcolors.agent-network.ssh-config-test
                                 'io.github.getcolors.agent-network.tools-test
                                 'io.github.getcolors.agent-network.workflow-test)]
                (System/exit (if (pos? (+ fail error)) 1 0)))}
  golden {:task (shell "../scripts/golden.sh")}
  golden:accept {:task (shell "../scripts/golden.sh" "--accept")}
  pin {:task (load-file "tasks/pin.clj")}}}
