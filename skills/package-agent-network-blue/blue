# Stamped by `bb pin`. AGENT_NETWORK_LIB_ROOT=/path/to/agent-network still
# overrides the pin with a working tree.
"""Thin launcher for package-agent-network-blue.

This file is both the skill payload and the repository entry point —
blue/blue in the repository is a symlink to it. It deliberately holds no
logic of its own: validation, the graph and the steps all live in the
package-agent-network-blue library, where the test suite reaches them. A
copied payload is the one place in this project where code cannot be tested,
so nothing that can live elsewhere should live here.
"""

import os
import subprocess
import sys

UNPINNED_ERROR = """\
this launcher carries no agent-network pin.
It has not been stamped by `bb pin`, which cannot run until the agent-network
repository has been pushed.
Point it at a checkout meanwhile: AGENT_NETWORK_LIB_ROOT=/path/to/agent-network
(or run through the repository project: cd agent-network/blue && uv run python -m package_agent_network_blue ...)
"""


def _lib_root_project(root: str) -> str:
    """The uv project inside an AGENT_NETWORK_LIB_ROOT checkout: the
    repository root or its blue/ implementation both work."""
    if os.path.isfile(os.path.join(root, "pyproject.toml")):
        return root
    return os.path.join(root, "blue")


def main() -> None:
    root = os.environ.get("AGENT_NETWORK_LIB_ROOT")
    if root:
        result = subprocess.run(
            ["uv", "run", "--project", _lib_root_project(root),
             "python", "-m", "package_agent_network_blue", *sys.argv[1:]])
        raise SystemExit(result.returncode)
    try:
        from package_agent_network_blue import exec  # resolvable only once pinned
    except ImportError:
        sys.stderr.write(UNPINNED_ERROR)
        raise SystemExit(2)
    exec()


if __name__ == "__main__":
    main()
