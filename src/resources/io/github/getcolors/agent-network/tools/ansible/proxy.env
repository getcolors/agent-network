# NetBird reverse proxy, private mode — the peer that serves the keyless
# agent-network endpoint. Derived from what the upstream installer's
# agent-network preset generates, with one deliberate departure: endpoint TLS
# comes from a wildcard certificate issued at converge time (DNS-01, lego),
# not from the proxy's own per-name ACME. The pinned 0.77.1 binary's per-name
# ACME responder is defective — every order dies with "no viable challenge
# type found" against authorizations that offer tls-alpn-01, under every
# accepted NB_PROXY_ACME_CHALLENGE_TYPE value, on production and staging Let's
# Encrypt alike, while each deactivated authorization burns the CA's
# failed-authorization rate limit. Verified empirically 2026-08-26 against
# live authz objects; re-test before re-enabling ACME on an image bump.
#
# The token is minted on this host with `netbird-server admin token create`
# and substituted by the playbook; it never enters .colors/.
NB_PROXY_DEBUG_LOGS=false
# The internal Docker network, so management is reached without hairpin NAT.
NB_PROXY_MANAGEMENT_ADDRESS=http://netbird-server:80
# Allow insecure gRPC to management: the hop above never leaves the compose
# network.
NB_PROXY_ALLOW_INSECURE=true
# Public cluster address; the endpoint hangs one label beneath it.
NB_PROXY_DOMAIN=<{ agent-network-host }>
NB_PROXY_ADDRESS=:8443
NB_PROXY_TOKEN=__PROXY_TOKEN__
# The wildcard pair issued at converge time covers every generated endpoint
# label. Served both as the static certificate (file-watched, so a renewed
# pair is picked up in place) and as the wildcard directory (SAN-matched per
# hostname) — the empirically working combination on 0.77.1.
NB_PROXY_CERTIFICATE_DIRECTORY=/wildcard
NB_PROXY_CERTIFICATE_FILE=wildcard.crt
NB_PROXY_CERTIFICATE_KEY_FILE=wildcard.key
NB_PROXY_WILDCARD_CERT_DIR=/wildcard
NB_PROXY_ACME_CERTIFICATES=false
NB_PROXY_FORWARDED_PROTO=https
# PROXY protocol from Traefik's TCP passthrough preserves client addresses;
# trust exactly Traefik's fixed address for those headers.
NB_PROXY_PROXY_PROTOCOL=true
NB_PROXY_TRUSTED_PROXIES=<{ traefik-ip }>
# Private mode: serve only agent-network synth routes and the per-account
# inbound listeners on the embedded netstack — identity comes from the
# WireGuard tunnel, and a caller without a tunnel has none.
NB_PROXY_PRIVATE=true
